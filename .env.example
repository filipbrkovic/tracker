# Compose: set a private LAN address for phone access.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3187
LOCALCAL_DATA=/DATA/AppData/localcal
# Direct Go execution (Compose overrides these).
PORT=8080
DATA_DIR=./data
STATIC_DIR=.
TZ=Europe/Zagreb
# Optional online food lookup. Core logging works without this service.
FOOD_SEARCH_WORKER_URL=
FOOD_SEARCH_WORKER_TOKEN=
